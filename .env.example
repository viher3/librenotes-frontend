# Base URL of the Symfony backend, as the browser sees it.
# In development use the same-origin proxy (/backend -> BACKEND_PROXY_TARGET): the backend's CORS setup
# does not allow the Authorization header from another origin yet. In production, point it at the API.
VITE_API_URL=/backend
# Where the development proxy forwards /backend to (read by vite.config.ts, never shipped to the browser)
BACKEND_PROXY_TARGET=http://localhost
# http | mock (mock = in-memory fake with seeded demo data, development only: demo@example.com / demo12345)
VITE_DATA_ADAPTER=http
